<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="org.kazinduzi.rinjora.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_repairs"
        android:name="org.kazinduzi.rinjora.ui.repairs.RepairsFragment"
        android:label="Repairs"
        tools:layout="@layout/fragment_repairs" />

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="org.kazinduzi.rinjora.ui.notifications.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="org.kazinduzi.rinjora.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/navigation_support"
        android:name="org.kazinduzi.rinjora.ui.support.SupportFragment"
        android:label="Support"
        tools:layout="@layout/fragment_support" />

</navigation>
